{% comment %}
  Local override of al_folio_core's _includes/header.liquid (identical to the version in al_folio_core 1.0.15).
  Two changes to the navbar brand (the site owner's name):
  1. It is rendered on every page. Upstream wraps it in `if page.permalink != '/'`, hiding it on the home page
     and showing optional navbar social icons there instead.
  2. The first name is not bold (upstream wraps it in <span class="font-weight-bold">).
  3. The style block below turns the top navbar into a fixed left sidebar on screens at least 992px wide
     (name kept on one line at 18.5px; social icons listed under the menu links); narrower screens keep the
     top bar with its menu button, and the icons sit in the top bar next to the links (inside the menu on phones).
  4. The style block also hides the site footer (the theme's "© Copyright" bar) on every page.
  When bumping al_folio_core, diff this file against the gem's copy.
{% endcomment %}
<style>
  @media (min-width: 992px) {
    /* The theme's nav script sets body padding-top to the navbar height (the full screen height here); cancel it. */
    body.fixed-top-nav { padding-top: 0 !important; padding-left: 210px; }
    #navbar.navbar { position: fixed !important; top: 0; bottom: 0; left: 0; right: auto; width: 210px; height: 100vh; padding: 1.5rem 0; border-bottom: none; border-right: 1px solid var(--global-divider-color); align-items: stretch; }
    #navbar > .container { flex-direction: column; flex-wrap: nowrap; align-items: flex-start; height: 100%; max-width: none; margin: 0; padding: 0 1.25rem; }
    #navbar .navbar-brand { margin: 0 0 1.5rem; white-space: normal; }
    #navbar .navbar-collapse { display: flex !important; flex-direction: column; align-items: stretch; width: 100%; flex-grow: 1; }
    #navbar .navbar-nav { flex-direction: column; align-items: flex-start; margin-left: 0 !important; width: 100%; height: 100%; text-align: left; }
    #navbar .navbar-nav .nav-item { width: 100%; text-align: left; }
    #navbar .navbar-nav .nav-link { padding: 0.35rem 0; text-align: left; }
    #navbar .navbar-nav .toggle-container { margin-top: auto; }
    #progress { position: fixed !important; top: 0 !important; left: 210px; width: calc(100% - 210px); }
    #navbar .navbar-brand { white-space: nowrap; font-size: 18.5px; } /* fits the 169px inside the sidebar */
    #navbar .navbar-nav .sidebar-social { display: flex; gap: 0.9rem; width: 100%; margin-top: 1.25rem; font-size: 1.25rem; }
    #navbar .navbar-nav .sidebar-social a { color: var(--global-text-color); }
    #navbar .navbar-nav .sidebar-social a:hover { color: var(--global-theme-color); }
  }
  @media (max-width: 991.98px) {
    /* Top-bar mode: icons next to the menu links (inside the collapsed menu on phones). */
    #navbar .navbar-nav .sidebar-social { display: flex; align-items: center; gap: 0.6rem; padding: 0 0.5rem; font-size: 1.05rem; }
    #navbar .navbar-nav .sidebar-social a { color: var(--global-text-color); }
    #navbar .navbar-nav .sidebar-social a:hover { color: var(--global-theme-color); }
  }
  /* No footer: the theme's footer only holds the copyright line. */
  footer[role="contentinfo"] { display: none; }
</style>
<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
        {% if site.title == 'blank' %}
          {% if site.first_name %}
            {{- site.first_name -}}
          {% endif %}
          {% if site.middle_name %}
            {{- site.middle_name -}}
          {% endif %}
          {% if site.last_name %}
            {{- site.last_name -}}
          {% endif %}
        {% else %}
          {{- site.title -}}
        {% endif %}
      </a>
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" type="button" title="Search" aria-label="Open search">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          <!-- Social icons: shown only in sidebar mode (see style block above) -->
          <li class="nav-item sidebar-social">{% social_links %}</li>
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
